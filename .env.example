# Fuer die lokale Vorschau als .env.local kopieren.
# Testversand ohne SMTP-Zugang: Empfaenger muss die Aktivierungsmail bestaetigen.
MAIL_TRANSPORT=formsubmit
EMPFAENGER=
FORMULAR_URL=http://127.0.0.1:8080/

# Alternativ MAIL_TRANSPORT=smtp und ein eigenes Postfach konfigurieren:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ABSENDER=
